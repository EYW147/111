{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.2,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "cschin",
        "repo": "pydna",
        "enabled": true,
        "category": "bioinformatics-tools"
      },
      {
        "type": "repo_releases",
        "owner": "opencobra",
        "repo": "cobrapy",
        "enabled": true,
        "category": "metabolic-modeling"
      },
      {
        "type": "repo_releases",
        "owner": "Edinburgh-Genome-Foundry",
        "repo": "DnaChisel",
        "enabled": true,
        "category": "synthetic-biology"
      }
    ],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "rss": [
      {
        "name": "Nature Biotechnology",
        "url": "https://www.nature.com/nbt.rss",
        "enabled": true,
        "category": "biomanufacturing"
      },
      {
        "name": "Nature Chemical Biology",
        "url": "https://www.nature.com/nchembio.rss",
        "enabled": true,
        "category": "synthetic-biology"
      },
      {
        "name": "The ISME Journal",
        "url": "https://www.nature.com/ismej.rss",
        "enabled": true,
        "category": "industrial-microbiology"
      },
      {
        "name": "bioRxiv Synthetic Biology",
        "url": "https://connect.biorxiv.org/biorxiv_xml.php?subject=synthetic_biology",
        "enabled": true,
        "category": "synthetic-biology"
      },
      {
        "name": "bioRxiv Microbiology",
        "url": "https://connect.biorxiv.org/biorxiv_xml.php?subject=microbiology",
        "enabled": true,
        "category": "industrial-microbiology"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["Python", "Jupyter Notebook"],
      "keywords": [
        "bioinformatics",
        "synthetic biology",
        "metabolic",
        "genome",
        "protein",
        "bioprocess",
        "microbiology"
      ],
      "min_stars": 5,
      "max_items": 10,
      "category": "bioinformatics-tools"
    },
    "gdelt": {
      "enabled": true,
      "query": "(fermentation OR bioprocess OR biomanufacturing OR \"metabolic engineering\" OR \"synthetic biology\")",
      "mode": "ArtList",
      "max_records": 40,
      "timespan": "2d",
      "language": null,
      "country": null,
      "category": "industry-news"
    },
    "google_news": {
      "enabled": true,
      "query": "(fermentation OR bioprocess OR biomanufacturing OR \"metabolic engineering\" OR \"industrial biotechnology\" OR \"synthetic biology\")",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 60,
      "category": "industry-news"
    }
  },
  "filtering": {
    "ai_score_threshold": 6.8,
    "time_window_hours": 48,
    "max_items": 18,
    "category_groups": {
      "research": {
        "name": "论文与科研进展",
        "limit": 8,
        "categories": ["synthetic-biology", "industrial-microbiology", "metabolic-modeling"]
      },
      "industry": {
        "name": "产业与生物制造",
        "limit": 5,
        "categories": ["biomanufacturing", "industry-news"]
      },
      "tools": {
        "name": "科研工具与数据分析",
        "limit": 5,
        "categories": ["bioinformatics-tools"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "request_body": {
      "text": "#{message_title}\n\n#{summary?limit=12000&split=---}"
    },
    "headers": ""
  }
}
